{
  "name": "dsh-import-workbuddy",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "description": "Import WorkBuddy (Tencent CodeBuddy) chat history into DeepSeek Harness (dsh) as native, resumable sessions grouped by their original workspace.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "codebuddy",
    "session-import",
    "chat-history",
    "migration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuchuan000/dsh-import-workbuddy.git"
  },
  "bugs": {
    "url": "https://github.com/yuchuan000/dsh-import-workbuddy/issues"
  },
  "homepage": "https://github.com/yuchuan000/dsh-import-workbuddy#readme",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./core": "./lib/import-core.mjs",
    "./reader": "./lib/workbuddy-reader.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "import": "node import.mjs",
    "import:list": "node import.mjs --list",
    "import:apply": "node import.mjs --apply",
    "attach": "node attach-workspaces.mjs",
    "attach:apply": "node attach-workspaces.mjs --apply",
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src/",
    "lib/",
    "test/",
    "import.mjs",
    "export.mjs",
    "attach-workspaces.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
